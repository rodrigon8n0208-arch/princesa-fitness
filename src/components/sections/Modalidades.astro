---
import { Image } from 'astro:assets';
import Highlight from '../ui/Highlight.astro';
import Icon from '../ui/Icon.astro';
import { MODALIDADES, whatsappUrl } from '../../data/site';
import { slot, fitWidths } from '../../data/images';

const cards = MODALIDADES.map((m) => {
  const s = slot(m.slot, m.fallback);
  return { ...m, image: s.image, imageAlt: s.isCustom ? m.alt : m.fallbackAlt };
});
---

<section class="mods" id="modalidades" aria-labelledby="mods-title" data-mods>
  <div class="mods__pin" data-mods-pin>
    <div class="container mods__head">
      <div>
        <p class="eyebrow" data-reveal>Modalidades</p>
        <h2 class="display section-title" id="mods-title" data-reveal-title>
          <span class="thin">Treine do</span>
          <span class="bold"><Highlight>seu jeito</Highlight></span>
        </h2>
      </div>
      <p class="mods__hint" aria-hidden="true">
        <span class="mods__hint-desk">Role para ver mais</span>
        <span class="mods__hint-mob">Arraste para o lado</span>
        <Icon name="arrow-right" />
      </p>
    </div>

    <div class="mods__viewport" data-mods-viewport>
      <ul class="mods__track" data-mods-track>
        {
          cards.map((m, i) => (
            <li class:list={['mod', { 'mod--graphic': !m.image }]} data-mod>
              <div class="mod__media">
                {m.image ? (
                  <div class="brand-photo grain mod__photo">
                    <Image
                      src={m.image}
                      alt={m.imageAlt}
                      widths={fitWidths([420, 640, 900], m.image)}
                      sizes="(min-width: 1024px) 34vw, 82vw"
                      class="mod__img"
                    />
                  </div>
                ) : (
                  <div class="mod__graphic" aria-hidden="true">
                    <span class="mod__graphic-word">{m.name}</span>
                    <span class="mod__stripes" />
                  </div>
                )}
                <span class="mod__num">0{i + 1}</span>
                {m.premium && <span class="mod__tag">Incluída no Premium</span>}
              </div>
              <div class="mod__body">
                <p class="mod__kicker">{m.kicker}</p>
                <h3 class="mod__name">{m.name}</h3>
                <p class="mod__text">{m.text}</p>
                <a
                  href={whatsappUrl(`Olá! Vim pelo site e quero saber mais sobre ${m.name} na Princesa Fitness.`)}
                  class="btn btn--ghost mod__cta"
                  target="_blank"
                  rel="noopener"
                >
                  <span class="btn__inner">
                    Quero essa <Icon name="arrow-up-right" />
                  </span>
                  <span class="sr-only"> — {m.name} (abre o WhatsApp)</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .mods {
    position: relative;
    padding-block: var(--section-y);
    background: var(--pf-surface);
    overflow-x: clip;
  }

  .mods__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .mods__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pf-muted);
  }

  .mods__hint :global(.icon) {
    width: 18px;
    color: var(--pf-red-hot);
  }

  .mods__hint-desk {
    display: none;
  }

  /* Mobile: carrossel nativo com snap (arrastável no toque) */
  .mods__viewport {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }

  .mods__viewport::-webkit-scrollbar {
    display: none;
  }

  .mods__track {
    display: flex;
    gap: 1rem;
    width: max-content;
  }

  .mod {
    flex: none;
    width: min(82vw, 380px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--pf-black);
    border: 1px solid var(--pf-line);
    overflow: hidden;
  }

  .mod__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .mod__photo {
    position: absolute;
    inset: 0;
  }

  .mod__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  @media (hover: hover) {
    .mod:hover .mod__img {
      transform: scale(1.06);
    }
  }

  .mod__graphic {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 0% 0%, var(--pf-red-hot), transparent 60%),
      linear-gradient(150deg, var(--pf-red), var(--pf-red-deep));
  }

  .mod__graphic-word {
    position: relative;
    z-index: 1;
    font-size: clamp(2.6rem, 11vw, 4.25rem);
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);
    transform: rotate(-13deg);
  }

  .mod__stripes {
    position: absolute;
    inset: -20%;
    background: repeating-linear-gradient(
      -77deg,
      transparent 0 26px,
      rgba(0, 0, 0, 0.16) 26px 34px
    );
  }

  .mod__num {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    z-index: 2;
    font-size: var(--fs-xs);
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.12em;
  }

  .mod__tag {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--pf-black);
    font-size: 0.6875rem;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mod__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .mod__kicker {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pf-muted);
  }

  .mod__name {
    font-size: var(--fs-xl);
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 1;
  }

  .mod__text {
    color: var(--pf-muted);
    font-size: var(--fs-sm);
  }

  .mod__cta {
    margin-top: auto;
    align-self: flex-start;
    min-height: 46px;
    padding: 0.7rem 1.2rem;
    font-size: var(--fs-xs);
  }

  .mod__body > .mod__text {
    margin-bottom: 1rem;
  }

  /* Desktop: o JS fixa a seção e move o trilho na horizontal */
  @media (min-width: 1024px) {
    .mods__hint-desk {
      display: inline;
    }
    .mods__hint-mob {
      display: none;
    }

    .mods__viewport {
      overflow: visible;
      scroll-snap-type: none;
      padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    }

    .mods__pin {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 2rem;
    }

    .mods__viewport {
      margin-top: clamp(1.5rem, 4vh, 3rem);
    }

    /* Largura ligada à altura da tela para o bloco fixado caber em notebooks */
    .mod {
      width: clamp(300px, min(30vw, 50vh), 440px);
    }

    .mod__media {
      aspect-ratio: 3 / 2;
    }
  }

  /* Sem JS ou com movimento reduzido no desktop: rola na horizontal normalmente */
  @media (min-width: 1024px) {
    :global(html:not(.motion-ready)) .mods__viewport,
    :global(html.reduce-motion) .mods__viewport {
      overflow-x: auto;
    }
    :global(html:not(.motion-ready)) .mods__hint-desk,
    :global(html.reduce-motion) .mods__hint-desk {
      display: none;
    }
    :global(html:not(.motion-ready)) .mods__hint-mob,
    :global(html.reduce-motion) .mods__hint-mob {
      display: inline;
    }
  }
</style>
