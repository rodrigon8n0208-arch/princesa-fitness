---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { NAV, SITE, HOURS_SUMMARY, whatsappUrl } from '../../data/site';
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo class="footer__logo" />
      <p class="footer__tagline">Transformando vidas através do treino. Saúde, força e evolução todos os dias.</p>
    </div>

    <nav class="footer__col" aria-label="Rodapé">
      <p class="footer__title">Navegue</p>
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <p class="footer__title">Contato</p>
      <ul>
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
        </li>
        <li>
          <a href={SITE.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> {SITE.instagram.handle}</a>
        </li>
        <li class="footer__addr">
          <Icon name="pin" />
          <span>{SITE.address.street}, {SITE.address.district}<br />{SITE.address.city} - {SITE.address.state}</span>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <p class="footer__title">Horário</p>
      <ul>
        {
          HOURS_SUMMARY.map((h) => (
            <li>
              {h.label}: {h.value}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© <span data-year>{new Date().getFullYear()}</span> {SITE.name}. Todos os direitos reservados.</p>
    <a href="#topo" class="footer__top">Voltar ao topo ↑</a>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 8vw, 6rem);
    background: var(--pf-black);
    border-top: 1px solid var(--pf-line);
    font-size: var(--fs-sm);
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .footer :global(.footer__logo) {
    width: 200px;
  }

  .footer__tagline {
    margin-top: 1.25rem;
    max-width: 32ch;
    color: var(--pf-muted);
  }

  .footer__title {
    margin-bottom: 1rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer__col ul {
    display: grid;
    gap: 0.35rem;
    color: var(--pf-muted);
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    transition: color 0.25s;
  }

  @media (hover: hover) {
    .footer__col a:hover {
      color: var(--pf-white);
    }
  }

  .footer__col :global(.icon) {
    width: 18px;
    flex: none;
    color: var(--pf-red-hot);
  }

  .footer__addr {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }

  .footer__addr :global(.icon) {
    margin-top: 0.2rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-block: 1.5rem calc(1.5rem + 72px);
    border-top: 1px solid var(--pf-line);
    font-size: var(--fs-xs);
    color: var(--pf-muted);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.4fr repeat(3, 1fr);
    }
    .footer__bottom {
      padding-bottom: 1.5rem;
      padding-right: calc(var(--gutter) + 80px);
    }
  }
</style>
